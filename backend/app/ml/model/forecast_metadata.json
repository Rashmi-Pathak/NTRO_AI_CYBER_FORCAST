{
  "modelName": "AttackForecastModel",
  "version": "1.0",
  "features": [
    "total_events",
    "attack_count",
    "failed_auth_count",
    "byte_count",
    "hour",
    "day_of_week",
    "is_weekend",
    "rolling_mean_4",
    "rolling_std_4",
    "lag_1",
    "lag_2",
    "lag_4"
  ],
  "target": "target_next_window",
  "window_hours": 6,
  "trainingRows": 72,
  "metrics": {
    "validation_mae": 12.56,
    "test_mae": 10.17,
    "test_r2": -1.26
  }
}